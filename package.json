{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "Scalable REST API with JWT Auth & RBAC — Backend Intern Assignment",
  "main": "dist/server.js",
  "scripts": {
    "dev":       "ts-node-dev --respawn --transpile-only src/server.ts",
    "build":     "tsc",
    "start":     "node dist/server.js",
    "db:push":   "prisma db push",
    "db:studio": "prisma studio",
    "test":      "jest --coverage"
  },
  "dependencies": {
    "@prisma/client":   "^5.12.1",
    "bcryptjs":         "^2.4.3",
    "cors":             "^2.8.5",
    "dotenv":           "^16.4.5",
    "express":          "^5.0.0",
    "express-rate-limit":"^7.2.0",
    "helmet":           "^7.1.0",
    "jsonwebtoken":     "^9.0.2",
    "swagger-ui-express":"^5.0.0",
    "winston":          "^3.13.0",
    "yamljs":           "^0.3.0",
    "zod":              "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs":          "^2.4.6",
    "@types/cors":              "^2.8.17",
    "@types/express":           "^4.17.21",
    "@types/jsonwebtoken":      "^9.0.6",
    "@types/node":              "^20.12.7",
    "@types/swagger-ui-express":"^4.1.6",
    "@types/yamljs":            "^0.2.34",
    "prisma":                   "^5.12.1",
    "ts-node-dev":              "^2.0.0",
    "typescript":               "^5.4.5",
    "jest":                     "^29.7.0",
    "ts-jest":                  "^29.1.2"
  }
}
